# The template lists the settings of the software design document which
# differ from the defaults of Doxygen.  The package items and ./waf doxygen
# replace each placeholder before Doxygen reads the file.

PROJECT_NAME           = "${.:/component/document-package-title} Software Design Document [${.:/component/ident}]"
PROJECT_NUMBER         = "Release ${.:/component/package-version}"
OUTPUT_DIRECTORY       = "${.:/output-directory}"
STRIP_FROM_PATH        = ${.:/strip-from-path}
STRIP_FROM_INC_PATH    = ${.:/include-path}
TOC_INCLUDE_HEADINGS   = 0
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
CASE_SENSE_NAMES       = YES
SORT_GROUP_NAMES       = YES
INPUT                  = ${.:/input}
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cpp \
                         *.c++ \
                         *.inl \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++ \
                         *.inc \
                         *.dox
RECURSIVE              = YES
EXCLUDE_PATTERNS       = ${.:/exclude-patterns}
SOURCE_BROWSER         = YES
GENERATE_HTML          = ${.:/generate-html}
HTML_OUTPUT            = .
GENERATE_TREEVIEW      = NO
MATHJAX_RELPATH        = https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.2/
GENERATE_LATEX         = ${.:/generate-latex}
LATEX_CMD_NAME         = latex
LATEX_BIB_STYLE        = plain
MACRO_EXPANSION        = YES
INCLUDE_PATH           = ${.:/include-path}
PREDEFINED             = __GNUC__ \
                         __aligned(x)= \
                         __asm__(x)= \
                         __attribute__(x)= \
                         __rtems__ \
                         "T_TEST_CASE(x)=void T_case_body_##x(void)" \
                         __STDC_VERSION__=201112L \
                         "RB_ENTRY(x)=struct { struct x *rbe_left; struct x *rbe_right; struct x *rbe_parent; int rbe_color; }"
GENERATE_TAGFILE       = "${.:/tagfile}"
HAVE_DOT               = YES
